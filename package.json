{
  "name": "@shipstatic/drop",
  "version": "2.1.1-beta.1",
  "description": "Headless React hook for file dropping, processing, ZIP extraction, and validation - purpose-built for Ship SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.cts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsup",
    "prepack": "pnpm run build",
    "dev": "tsup --watch",
    "test": "vitest --project main",
    "test:ci": "vitest --run --project main",
    "test:browser": "vitest --run --project browser",
    "coverage": "vitest --run --project main --coverage",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "check:package": "publint && attw --pack .",
    "prepare": "git config core.hooksPath scripts/githooks",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": [
    "react",
    "react-hook",
    "dropzone",
    "file-drop",
    "file-processing",
    "headless",
    "zip-extraction",
    "file-validation",
    "ship-sdk",
    "deployment"
  ],
  "author": "ShipStatic",
  "license": "MIT",
  "homepage": "https://github.com/shipstatic/drop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipstatic/drop.git"
  },
  "bugs": {
    "url": "https://github.com/shipstatic/drop/issues"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@shipstatic/ship": "2.2.0-beta.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.5",
    "@shipstatic/types": "2.7.0-beta.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^30.0.0",
    "playwright": "1.62.0",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
