{
  "name": "@shipstatic/drop",
  "version": "0.2.14",
  "description": "Headless React hook for file dropping, processing, ZIP extraction, and validation - purpose-built for Ship SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "prepare": "husky"
  },
  "keywords": [
    "react",
    "react-hook",
    "dropzone",
    "file-drop",
    "file-processing",
    "headless",
    "zip-extraction",
    "file-validation",
    "ship-sdk",
    "deployment"
  ],
  "author": "ShipStatic",
  "license": "MIT",
  "peerDependencies": {
    "@shipstatic/ship": "^0.4.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "mime-db": "^1.54.0"
  },
  "devDependencies": {
    "@shipstatic/ship": "^0.4.22",
    "@shipstatic/types": "^0.4.22",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/mime-db": "^1.43.6",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "buffer": "^6.0.3",
    "happy-dom": "^20.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "path-browserify": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}